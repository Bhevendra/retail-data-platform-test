{
  "platform": {
    "catalog": "retaildataplatform",
    "schema": "bronze",
    "raw_volume": "raw_data",
    "quality_results_table": "data_quality_results",
    "owner": "data-engineering",
    "tags": {"domain": "retail", "layer": "bronze", "classification": "internal"}
  },
  "sources": [
    {
      "name": "cosmos_sales_orders",
      "type": "cosmos_mongodb",
      "database": "retail",
      "collection": "sales_orders",
      "secret_keys": {"connection_string": "cosmos-connection-string"},
      "format": "json",
      "target_table": "sales_orders",
      "primary_keys": ["order_number"],
      "pii_columns": ["customer_name"],
      "quality_rules": [
        {"name": "order_number_not_null", "type": "not_null", "column": "order_number", "severity": "error"},
        {"name": "unique_order_number", "type": "unique", "column": "order_number", "severity": "error"}
      ]
    },
    {
      "name": "s3_sales",
      "type": "s3",
      "path": "s3://bucket-rivadata/retail/sales.parquet",
      "region": "eu-north-1",
      "secret_keys": {"access_key_id": "aws-access-key-id", "secret_access_key": "aws-secret-access-key"},
      "format": "parquet",
      "target_table": "sales",
      "primary_keys": ["order_number"],
      "quality_rules": [
        {"name": "sales_order_number_not_null", "type": "not_null", "column": "order_number", "severity": "error"}
      ]
    },
    {
      "name": "sqlserver_customers",
      "type": "sqlserver",
      "host": "rivadata.database.windows.net",
      "port": 1433,
      "database": "batch2",
      "table": "retail.customers",
      "secret_keys": {"username": "sqlserver-username", "password": "sqlserver-password"},
      "jdbc_options": {"trustServerCertificate": "true", "loginTimeout": "90"},
      "format": "csv",
      "target_table": "customers",
      "primary_keys": ["customer_id"],
      "pii_columns": ["customer_name", "email", "phone"],
      "quality_rules": [
        {"name": "customer_id_not_null", "type": "not_null", "column": "customer_id", "severity": "error"},
        {"name": "unique_customer_id", "type": "unique", "column": "customer_id", "severity": "error"}
      ]
    }
  ]
}
