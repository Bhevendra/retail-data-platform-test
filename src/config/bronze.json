{
  "platform": {
    "catalog": "retaildataplatform",
    "schema": "bronze",
    "raw_volume": "raw_data",
    "ops_schema": "ops",
    "owner": null,
    "tags": {
      "domain": "retail",
      "classification": "internal",
      "managed_by": "retail-data-platform"
    },
    "grants": {}
  },
  "sources": [
    {
      "name": "cosmos_sales_orders",
      "description": "Sales orders captured by the e-commerce platform (Cosmos DB, Mongo API). One document per order; nested line items are kept as a JSON string in Bronze and parsed in Silver.",
      "type": "cosmos_mongodb",
      "database": "retail",
      "collection": "sales_orders",
      "secret_keys": {
        "connection_string": "cosmos-connection-string"
      },
      "format": "json",
      "target_table": "sales_orders",
      "primary_keys": [
        "order_number"
      ],
      "pii_columns": [
        "customer_name"
      ],
      "on_quality_failure": "quarantine",
      "quality_rules": [
        {
          "name": "order_number_not_null",
          "type": "not_null",
          "column": "order_number",
          "severity": "error"
        },
        {
          "name": "customer_id_not_null",
          "type": "not_null",
          "column": "customer_id",
          "severity": "error"
        },
        {
          "name": "unique_order_number",
          "type": "unique",
          "column": "order_number",
          "severity": "warn",
          "description": "The source re-emits an order when lines are added; Silver keeps the latest version and the history."
        },
        {
          "name": "min_row_count",
          "type": "min_row_count",
          "min": 1,
          "severity": "error"
        }
      ],
      "column_comments": {
        "ordered_products": "JSON array of line items (parsed in Silver).",
        "clicked_items": "JSON array of [product_id, clicks] pairs.",
        "promo_info": "JSON array of promotions applied.",
        "order_datetime": "Epoch seconds of the order."
      }
    },
    {
      "name": "s3_sales",
      "description": "Point-of-sale transactions exported daily to Amazon S3 as Parquet. Copied byte-for-byte into the raw volume.",
      "type": "s3",
      "path": "s3://bucket-rivadata/retail/sales.parquet",
      "region": "eu-north-1",
      "secret_keys": {
        "access_key_id": "aws-access-key-id",
        "secret_access_key": "aws-secret-access-key"
      },
      "format": "parquet",
      "target_table": "sales",
      "primary_keys": [
        "customer_id",
        "order_date"
      ],
      "on_quality_failure": "quarantine",
      "quality_rules": [
        {
          "name": "customer_id_not_null",
          "type": "not_null",
          "column": "customer_id",
          "severity": "error"
        },
        {
          "name": "product_payload_present",
          "type": "not_null",
          "column": "product",
          "severity": "error"
        },
        {
          "name": "total_price_not_negative",
          "type": "range",
          "column": "total_price",
          "min": 0,
          "severity": "error"
        },
        {
          "name": "min_row_count",
          "type": "min_row_count",
          "min": 1,
          "severity": "error"
        }
      ],
      "pii_columns": [
        "customer_name"
      ],
      "column_comments": {
        "product": "JSON payload of the product sold: id, name, price, qty, unit, curr (parsed in Silver).",
        "total_price": "Line total = price x qty."
      }
    },
    {
      "name": "sqlserver_customers",
      "description": "Customer master data from the CRM (Azure SQL, retail.customers). Full extract landed as CSV.",
      "type": "sqlserver",
      "host": "rivadata.database.windows.net",
      "port": 1433,
      "database": "batch2",
      "table": "retail.customers",
      "secret_keys": {
        "username": "sqlserver-username",
        "password": "sqlserver-password"
      },
      "jdbc_options": {
        "trustServerCertificate": "true",
        "loginTimeout": "90"
      },
      "read_options": {
        "fetchsize": "10000"
      },
      "format": "csv",
      "target_table": "customers",
      "primary_keys": [
        "customer_id",
        "valid_from"
      ],
      "pii_columns": [
        "tax_id",
        "customer_name",
        "street",
        "number",
        "unit",
        "ship_to_address",
        "lon",
        "lat"
      ],
      "on_quality_failure": "quarantine",
      "quality_rules": [
        {
          "name": "customer_id_not_null",
          "type": "not_null",
          "column": "customer_id",
          "severity": "error"
        },
        {
          "name": "customer_name_not_null",
          "type": "not_null",
          "column": "customer_name",
          "severity": "error"
        },
        {
          "name": "unique_customer_version",
          "type": "expression",
          "expression": "valid_from IS NOT NULL",
          "severity": "error",
          "description": "(customer_id, valid_from) identifies a CRM version."
        },
        {
          "name": "min_row_count",
          "type": "min_row_count",
          "min": 1000,
          "severity": "warn",
          "description": "Full extract is ~29k rows; far fewer suggests a broken export."
        }
      ],
      "column_comments": {
        "valid_from": "CRM validity start (epoch seconds).",
        "valid_to": "CRM validity end (epoch seconds), NULL while active."
      }
    }
  ]
}
